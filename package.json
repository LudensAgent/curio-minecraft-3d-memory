{
  "name": "curio-minecraft-3d-memory",
  "version": "0.11.0",
  "description": "Spatial memory and navigation library for a Minecraft Java 1.20.1 agent — historical geometry, recent observation state, derived traversability, and composable navigation helpers for land walking and surface-water movement.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./memory": {
      "types": "./dist/memory/index.d.ts",
      "import": "./dist/memory/index.js"
    },
    "./navigation": {
      "types": "./dist/navigation/index.d.ts",
      "import": "./dist/navigation/index.js"
    },
    "./storage/sqlite": {
      "types": "./dist/storage/sqlite/index.d.ts",
      "import": "./dist/storage/sqlite/index.js"
    },
    "./water": {
      "types": "./dist/water/index.d.ts",
      "import": "./dist/water/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "pretypecheck": "npm run build",
    "pretest": "npm run build",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/index.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "better-sqlite3": "^12.0.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "keywords": [
    "minecraft",
    "mineflayer",
    "spatial-memory",
    "navigation",
    "voxel"
  ],
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.0.0",
    "better-sqlite3": "^12.11.1",
    "tsx": "^4.19.0",
    "typescript": "^5.9.2",
    "vitest": "^2.1.0"
  }
}
